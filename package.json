{
  "name": "al-si.com",
  "private": true,
  "version": "2.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build && rm -f dist/client/index.html dist/client/index.pageContext.json && node scripts/generate-sitemap.mjs && cp -r functions dist/client/functions",
    "lint": "eslint .",
    "preview": "vike preview",
    "deploy": "bash scripts/deploy.sh",
    "deploy:preview": "bash scripts/deploy.sh preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html,yml,yaml,xml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "framer-motion": "^12.35.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vike": "^0.4.256",
    "vike-react": "^0.6.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.4",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.1",
    "vite": "^7.2.2",
    "vitest": "^4.1.0"
  }
}
